    let globalFinalTotal = 0;

    function getShippingFee() {
        const districtSelect = document.getElementById("district");
        const selectedDistrict = districtSelect ? districtSelect.value : "";
        
        // ডিস্ট্রিক্ট যদি 'Faridpur' হয় তবে ৳60, অন্যথায় বা সিলেক্ট না করলে ৳120
        if (selectedDistrict === "Faridpur") {
            return 60;
        } else {
            return 120;
        }
    }

    function loadCheckout() {
        const isDirect = localStorage.getItem('isDirectCheckout') === 'true';
        let items = [];

        if (isDirect) {
            const singleItem = JSON.parse(localStorage.getItem('checkoutItem'));
            if (singleItem) items = [singleItem];
        } else {
            items = JSON.parse(localStorage.getItem('cart')) || [];
        }

        const container = document.getElementById('checkout-items');
        const subtotalEl = document.getElementById('summary-subtotal');
        const shippingEl = document.getElementById('summary-shipping');
        const totalEl = document.getElementById('checkout-total');
        
        if (items.length === 0) {
            window.location.href = '/';
            return;
        }

        let subtotal = 0;
        
        container.innerHTML = items.map((item, index) => {
            const rawPrice = item.regularPrice ? item.regularPrice.toString() : "0";
            const itemPrice = parseFloat(rawPrice.replace(/[^0-9.-]+/g, "")) || 0;
            const itemTotal = itemPrice * item.quantity;
            subtotal += itemTotal;

            let sizeSelectHtml = '';
            if (item.sizes && item.sizes.length > 0) {
                sizeSelectHtml = `
                    <div class="mt-1">
                        <select onchange="updateItemSize(${index}, this.value)" class="size-dropdown border text-xs rounded px-2 py-1 bg-white outline-none focus:border-black font-medium text-gray-700">
                            <option value="">-- Choose Size * --</option>
                            ${item.sizes.map(size => `
                                <option value="${size}" ${item.selectedSize === size ? 'selected' : ''}>Size: ${size}</option>
                            `).join('')}
                        </select>
                    </div>
                `;
            } else {
                sizeSelectHtml = `<span class="text-xs text-gray-400 block mt-1">Free Size</span>`;
            }

            return `
                <div class="border-b pb-3 text-sm text-gray-600">
                    <div class="flex justify-between items-start gap-2">
                        <div class="flex-1">
                            <img src='${item.img}' class='w-16'>
                            <span class="line-clamp-1 font-medium text-gray-800">${item.title}</span>
                            
                            <div class="flex items-center gap-2 mt-1.5">
                                <span class="text-xs font-semibold text-gray-500">Qty:</span>
                                <div class="inline-flex items-center border border-gray-300 rounded bg-white">
                                    <button type="button" onclick="changeQuantity(${index}, -1)" class="px-2 py-0.5 text-gray-600 hover:bg-gray-100 font-bold">-</button>
                                    <span class="px-2.5 text-xs font-bold text-black">${item.quantity}</span>
                                    <button type="button" onclick="changeQuantity(${index}, 1)" class="px-2 py-0.5 text-gray-600 hover:bg-gray-100 font-bold">+</button>
                                </div>
                            </div>

                            ${sizeSelectHtml}
                        </div>
                        <span class="whitespace-nowrap font-semibold text-gray-900 mt-0.5">৳${itemTotal.toFixed(2)}</span>
                    </div>
                </div>
            `;
        }).join('');
        
        let shippingFee = getShippingFee();
        globalFinalTotal = subtotal + shippingFee;

        subtotalEl.innerText = '৳' + subtotal.toFixed(2);
        shippingEl.innerText = '৳' + shippingFee.toFixed(2);
        totalEl.innerText = '৳' + globalFinalTotal.toFixed(2);
    }

    function changeQuantity(index, amount) {
        const isDirect = localStorage.getItem('isDirectCheckout') === 'true';
        let items = isDirect ? [JSON.parse(localStorage.getItem('checkoutItem'))] : (JSON.parse(localStorage.getItem('cart')) || []);

        if (items[index]) {
            items[index].quantity += amount;
            if (items[index].quantity < 1) {
                items[index].quantity = 1;
            }

            if (isDirect) {
                localStorage.setItem('checkoutItem', JSON.stringify(items[0]));
            } else {
                localStorage.setItem('cart', JSON.stringify(items));
            }
            loadCheckout();
        }
    }

    function updateItemSize(index, newSize) {
        const isDirect = localStorage.getItem('isDirectCheckout') === 'true';
        let items = isDirect ? [JSON.parse(localStorage.getItem('checkoutItem'))] : (JSON.parse(localStorage.getItem('cart')) || []);

        if (items[index]) {
            items[index].selectedSize = newSize;
            if (isDirect) {
                localStorage.setItem('checkoutItem', JSON.stringify(items[0]));
            } else {
                localStorage.setItem('cart', JSON.stringify(items));
            }
        }
    }

    // 🔄 ড্রপডাউন হ্যান্ডেল করার লজিক (A to Z Sorting সহ)
    document.addEventListener("DOMContentLoaded", () => {
        loadCheckout();

        const divisionSelect = document.getElementById("division");
        const districtSelect = document.getElementById("district");
        const upazilaSelect = document.getElementById("upazila");

        // ১. বিভাগগুলো A-Z অ্যালফাবেটিকালি সাজানো
        const sortedDivisions = Object.keys(bdLocations).sort();
        sortedDivisions.forEach(division => {
            let option = document.createElement("option");
            option.value = division;
            option.textContent = division;
            divisionSelect.appendChild(option);
        });

        // বিভাগ পরিবর্তন হলে
        divisionSelect.addEventListener("change", function () {
            const selectedDivision = this.value;
            districtSelect.innerHTML = '<option value="">-- জেলা নির্বাচন --</option>';
            upazilaSelect.innerHTML = '<option value="">-- উপজেলা নির্বাচন --</option>';
            upazilaSelect.disabled = true;

            if (selectedDivision && bdLocations[selectedDivision]) {
                districtSelect.disabled = false;
                
                // ২. জেলাগুলো A-Z অ্যালফাবেটিকালি সাজানো
                const sortedDistricts = Object.keys(bdLocations[selectedDivision]).sort();
                sortedDistricts.forEach(district => {
                    let option = document.createElement("option");
                    option.value = district;
                    option.textContent = district;
                    districtSelect.appendChild(option);
                });
            } else {
                districtSelect.disabled = true;
            }
            
            // বিভাগ পরিবর্তন হলে শিপিং রি-ক্যালকুলেট করা
            loadCheckout();
        });

        // জেলা পরিবর্তন হলে
        districtSelect.addEventListener("change", function () {
            const selectedDivision = divisionSelect.value;
            const selectedDistrict = this.value;
            upazilaSelect.innerHTML = '<option value="">-- উপজেলা নির্বাচন --</option>';

            if (selectedDistrict && bdLocations[selectedDivision][selectedDistrict]) {
                upazilaSelect.disabled = false;
                
                // ৩. উপজেলাগুলো A-Z অ্যালফাবেটিকালি সাজানো
                const sortedUpazilas = [...bdLocations[selectedDivision][selectedDistrict]].sort();
                
                if(sortedUpazilas.length === 0) {
                    let option = document.createElement("option");
                    option.value = "Sadar";
                    option.textContent = "Sadar";
                    upazilaSelect.appendChild(option);
                } else {
                    sortedUpazilas.forEach(upazila => {
                        let option = document.createElement("option");
                        option.value = upazila;
                        option.textContent = upazila;
                        upazilaSelect.appendChild(option);
                    });
                }
            } else {
                upazilaSelect.disabled = true;
            }

            // জেলা ফরিদপুর কিনা তা চেক করে শিপিং চার্জ ও টোটাল আপডেট
            loadCheckout();
        });
    });

    document.getElementById('order-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const isDirect = localStorage.getItem('isDirectCheckout') === 'true';
        let items = isDirect ? [JSON.parse(localStorage.getItem('checkoutItem'))] : (JSON.parse(localStorage.getItem('cart')) || []);

        if (items.length === 0) {
            Swal.fire('Error', 'No items to checkout!', 'error');
            return;
        }
        
        for (let i = 0; i < items.length; i++) {
            if (items[i].sizes && items[i].sizes.length > 0 && !items[i].selectedSize) {
                Swal.fire({
                    title: 'Size Required!',
                    text: `দয়া করে "${items[i].title}" প্রোডাক্টটির সাইজ সিলেক্ট করুন!`,
                    icon: 'warning',
                    confirmButtonColor: '#000000'
                });
                return;
            }
        }
        
        // 📦 ঠিকানা একত্রিত করা
        const division = document.getElementById('division').value;
        const district = document.getElementById('district').value;
        const upazila = document.getElementById('upazila').value;
        const detailedAddress = document.getElementById('detailed-address').value;

        const fullAddress = `${detailedAddress}, Upazila: ${upazila}, District: ${district}, Division: ${division}`;

        const orderData = {
            name: document.getElementById('name').value,
            phone: document.getElementById('phone').value,
            address: fullAddress,
            items: items,
            totalAmount: globalFinalTotal
        };

        try {
            Swal.fire({
                title: 'Processing Order...',
                text: 'Please wait while we secure your booking.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            const response = await fetch('/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData)
            });

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Order Placed Successfully!',
                    text: 'আপনার অর্ডারটি সফল হয়েছে।',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#000000'
                }).then(() => {
                    localStorage.removeItem('cart');
                    localStorage.removeItem('checkoutItem');
                    localStorage.removeItem('isDirectCheckout');
                    window.dispatchEvent(new CustomEvent('cartUpdated'));
                    window.location.href = `/order-success/${result.customOrderId}`;
                });
            } else {
                Swal.fire('Failed', result.message || 'অর্ডারটি সম্পন্ন করা যায়নি।', 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'সার্ভারে কানেক্ট করতে সমস্যা হচ্ছে, আবার চেষ্টা করুন!', 'error');
        }
    });
</script>

