<%- include('partials/headr') %>

<div class="container mx-auto px-6 py-12">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-2xl shadow-lg border border-gray-100">
        <h2 class="text-3xl font-bold mb-8 text-gray-800 border-b pb-4">Checkout Details</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <form id="order-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700">Full Name</label>
                    <input type="text" id="name" required class="w-full mt-1 px-4 py-3 border rounded-lg outline-none focus:ring-2 focus:ring-black">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700">Phone Number</label>
                    <input type="tel" id="phone" required class="w-full mt-1 px-4 py-3 border rounded-lg outline-none focus:ring-2 focus:ring-black">
                </div>

                <!-- 📍 ডাইনামিক বিভাগ, জেলা ও উপজেলা ড্রপডাউন সেকশন -->
                <div class="space-y-3">
                    <label class="block text-sm font-semibold text-gray-700">Delivery Address</label>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <div>
                            <select id="division" required class="w-full px-3 py-2.5 border rounded-lg text-xs bg-white outline-none focus:ring-2 focus:ring-black">
                                <option value="">-- বিভাগ নির্বাচন --</option>
                            </select>
                        </div>
                        <div>
                            <select id="district" required disabled class="w-full px-3 py-2.5 border rounded-lg text-xs bg-white outline-none focus:ring-2 focus:ring-black disabled:bg-gray-100 disabled:cursor-not-allowed">
                                <option value="">-- জেলা নির্বাচন --</option>
                            </select>
                        </div>
                        <div>
                            <select id="upazila" required disabled class="w-full px-3 py-2.5 border rounded-lg text-xs bg-white outline-none focus:ring-2 focus:ring-black disabled:bg-gray-100 disabled:cursor-not-allowed">
                                <option value="">-- উপজেলা নির্বাচন --</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <input type="text" id="detailed-address" required placeholder="বাসা/হোল্ডিং নম্বর, রোড, এলাকা (যেমন: গোয়ালচামট, ফরিদপুর)" class="w-full mt-1 px-4 py-3 border rounded-lg text-sm outline-none focus:ring-2 focus:ring-black">
                    </div>
                </div>

                <button type="submit" class="w-full bg-black text-white py-4 rounded-lg font-bold uppercase tracking-widest hover:bg-gray-800 transition shadow-lg cursor-pointer">
                    Place Order
                </button>
            </form>

            <div class="bg-gray-50 p-6 rounded-xl border flex flex-col justify-between">
                <div>
                    <h4 class="text-lg font-bold mb-4">Order Summary</h4>
                    <div id="checkout-items" class="space-y-4 mb-4 max-h-[320px] overflow-y-auto pr-1">
                    </div>
                </div>
                
                <div class="border-t pt-4 space-y-2">
                    <div class="flex justify-between text-sm text-gray-600">
                        <span>Subtotal:</span>
                        <span id="summary-subtotal">৳0.00</span>
                    </div>
                    <div class="flex justify-between text-sm text-gray-600">
                        <span>Shipping Fee:</span>
                        <span id="summary-shipping">৳0.00</span>
                    </div>
                    <div class="border-t pt-2 text-xl font-black text-red-600 flex justify-between">
                        <span>Total Bill:</span>
                        <span id="checkout-total">৳0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

