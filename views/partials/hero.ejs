<section class="container mx-auto px-4 mt-6">
    <div class="swiper mainHeroSwiper rounded-[30px] md:rounded-[40px] overflow-hidden shadow-xl">
        <div class="swiper-wrapper">
            
            <% banners.forEach(banner => { %>
                <!-- পিসিতে ব্যানারকে চ্যাপ্টা হওয়া থেকে বাঁচাতে h-[320px] md:h-[500px] এবং ওভারলে যুক্ত করা হয়েছে -->
                <div class="swiper-slide h-[300px] md:h-[800px] p-6 md:p-20 text-white 
                text-center flex flex-col justify-center items-center bg-cover bg-center bg-no-repeat relative group cursor-pointer" 
                     style="background-image: url('<%= banner.bUrl %>');" onclick="window.location.href='<%= banner.btnUrl || '#' %>'">
                    
                    <!-- ব্যাকগ্রাউন্ড ওভারলে (টেক্সট ফুটিয়ে তোলার জন্য এবং দেখতে স্টাইলিশ করার জন্য) -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>

                    <!-- কন্টেন্ট হোল্ডার (যাতে টেক্সট ওভারলে বা লেআউট নষ্ট না হয়) -->
                    <div class="relative z-10 flex flex-col items-center justify-center h-full max-w-2xl mx-auto">
                        
                        <!-- ট্যাগ -->
                        <% if (banner.tag) { %>
                            <span class="bg-white/20 backdrop-blur-md px-4 py-1.5 rounded-full font-bold tracking-[3px] md:tracking-[5px] uppercase text-[10px] md:text-xs mb-3 md:mb-4 text-red-400 border border-white/10 shadow-sm">
                                <%= banner.tag %>
                            </span>
                        <% } %>
                        
                        <!-- টাইটেল -->
                        <% if (banner.title) { %>
                            <h2 class="text-2xl sm:text-4xl md:text-6xl font-black mb-6 md:mb-8 brand-font uppercase tracking-tight leading-tight drop-shadow-md">
                                <%- banner.title %>
                            </h2>
                        <% } %>

                        <!-- বাটন (পিসিতে আরও প্রিমিয়াম লুক দিতে হোভার এফেক্ট যুক্ত করা হয়েছে) -->
                        <% if (banner.btnText) { %>
                            <span class="bg-red-600 hover:bg-red-700 text-white px-8 md:px-10 py-3.5 md:py-4 rounded-full font-bold text-xs uppercase tracking-widest transition-all duration-300 shadow-lg shadow-red-600/30 hover:scale-105 inline-flex items-center gap-2">
                                <%= banner.btnText %>
                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                            </span>
                        <% } %>

                    </div>
                </div>
            <% }) %>

        </div>
        <!-- পেজিনেশন ডট -->
        <div class="swiper-pagination !bottom-4"></div>
    </div>
</section>