<%- include('partials/headr') %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mx-auto px-4 sm:px-6 py-8 min-h-screen">
    <!-- Back Button -->
    <button onclick="if(document.referrer){history.back();}else{location.href='/'}" class="text-gray-500 hover:text-black transition flex items-center gap-2 mb-6 text-sm font-medium cursor-pointer">
        <i class="fa-solid fa-arrow-left"></i> Back
    </button>
    
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
        <!-- Image Gallery Section -->
        <div class="lg:w-1/2 flex flex-col-reverse lg:flex-row gap-4 select-none">
            <!-- Thumbnails -->
            <div id="thumbContainer" class="flex flex-row lg:flex-col gap-3 overflow-x-auto lg:overflow-y-auto lg:w-24 w-full custom-scrollbar py-1 max-h-[480px]">
                <% 
                    let imgs = [product.imgUrl, product.imgUrl2, product.imgUrl3, product.imgUrl4, product.imgUrl5].filter(Boolean);
                %>
                <% imgs.forEach((img, i) => { %>
                    <div onclick="switchImage('<%= img %>', <%= i %>)" data-index="<%= i %>" 
                         class="thumb-box w-16 h-16 lg:w-20 lg:h-20 rounded-2xl overflow-hidden border-2 bg-gray-50 cursor-pointer flex-shrink-0 transition-all duration-300 <%= i === 0 ? 'border-black ring-4 ring-gray-100 shadow-md scale-95' : 'border-gray-200 hover:border-gray-400' %>">
                        <img src="<%= img %>" class="w-full h-full object-cover pointer-events-none">
                    </div>
                <% }) %>
            </div>

            <!-- Main Display Box -->
            <div id="mainWrapper" class="flex-1 overflow-hidden rounded-3xl bg-gray-50 border border-gray-100 shadow-sm h-[360px] sm:h-[450px] lg:h-[480px] relative cursor-grab active:cursor-grabbing">
                <img id="mainDisplayImg" src="<%= imgs[0] %>" class="w-full h-full object-cover hover:scale-105 transition duration-500 rounded-3xl pointer-events-none">
                <div class="absolute bottom-4 right-4 bg-black/70 backdrop-blur-md text-white px-3 py-1 rounded-full text-xs font-mono font-bold lg:hidden">
                    <span id="currIdx">1</span>/<%= imgs.length %>
                </div>
            </div>
        </div>

        <!-- Product Details Section -->
        <div class="lg:w-1/2 space-y-6">
            <div class="flex flex-wrap items-center gap-2">
                <span class="px-3.5 py-1 bg-orange-50 text-orange-600 text-xs font-bold uppercase tracking-wider rounded-full border border-orange-100">
                    <%= product.category %>
                </span>
                <% let hasDisc = product.isDiscount === true || product.isDiscount === 'true'; %>
                <% if (hasDisc) { %>
                    <span class="px-3.5 py-1 bg-red-50 text-red-600 text-xs font-black uppercase tracking-wider rounded-full border border-red-100">SALE</span>
                    <% let off = Math.round(((product.regularPrice - product.discountPrice) / product.regularPrice) * 100); %>
                    <% if (off > 0) { %>
                        <span class="px-3 py-1 bg-red-600 text-white text-xs font-bold rounded-full shadow-sm animate-pulse"><%= off %>% OFF</span>
                    <% } %>
                <% } %>
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight"><%= product.title %></h1>

            <div class="flex items-baseline gap-4">
                <% let activePrice = hasDisc ? product.discountPrice : product.regularPrice; %>
                <p class="text-3xl font-black text-red-600">৳<%= Number(activePrice).toLocaleString() %></p>
                <% if (hasDisc) { %>
                    <p class="text-lg text-gray-400 line-through font-medium">৳<%= Number(product.regularPrice).toLocaleString() %></p>
                <% } %>
                <span class="text-emerald-600 font-medium text-xs bg-emerald-50 px-2.5 py-1 rounded-full ml-auto border border-emerald-100 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span> In Stock</span>
            </div>

            <% if (product.sizes?.length) { %>
                <div class="border-t border-gray-100 pt-4">
                    <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2.5">Available Sizes:</h4>
                    <div class="flex flex-wrap gap-2">
                        <% product.sizes.forEach(size => { %>
                            <span class="px-4 py-1.5 bg-gray-50 border border-gray-200 text-xs font-bold rounded-xl text-gray-800 select-none uppercase"><%= size %></span>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="border-t border-b border-gray-100 py-6 text-gray-600 leading-relaxed">
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-2">Description</h4>
                <p class="whitespace-pre-line text-sm text-gray-600"><%= product.content %></p>
            </div>

            <!-- Desktop Action Buttons -->
            <div class="hidden md:flex gap-4 pt-2">
                <button onclick="handleCart('add', '<%= product._id %>', '<%= product.title.replace(/'/g, "\\'") %>', '<%= activePrice %>', '<%= product.imgUrl %>', '<%= product.category %>')" class="flex-1 bg-black text-white py-4 px-8 rounded-2xl font-bold uppercase tracking-wider hover:bg-gray-800 transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2.5 cursor-pointer text-sm">
                    <i class="fa-solid fa-cart-plus"></i> Add to Cart
                </button>
                <button onclick="handleCart('buy', '<%= product._id %>', '<%= product.title.replace(/'/g, "\\'") %>', '<%= activePrice %>', '<%= product.imgUrl %>', '<%= product.category %>')" class="flex-1 bg-emerald-600 text-white py-4 px-8 rounded-2xl font-bold uppercase tracking-wider hover:bg-emerald-700 transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2.5 cursor-pointer text-sm">
                    <i class="fa-solid fa-bolt"></i> Buy Now
                </button>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                <div class="flex items-center gap-3 text-xs font-medium text-gray-500"><i class="fa-solid fa-truck-fast text-gray-900 text-base"></i> Fast Home Delivery</div>
                <div class="flex items-center gap-3 text-xs font-medium text-gray-500"><i class="fa-solid fa-rotate-left text-gray-900 text-base"></i> 7 Days Easy Return</div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Bar -->
<div class="flex gap-3 fixed bottom-0 left-0 w-full bg-white/90 backdrop-blur-md p-3 border-t border-gray-100 md:hidden z-50 shadow-2xl">
    <button onclick="handleCart('buy', '<%= product._id %>', '<%= product.title.replace(/'/g, "\\'") %>', '<%= activePrice %>', '<%= product.imgUrl %>', '<%= product.category %>')" class="flex-1 bg-emerald-600 text-white py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-md">
        <i class="fa-solid fa-bolt"></i> Buy Now
    </button>
    <button onclick="handleCart('add', '<%= product._id %>', '<%= product.title.replace(/'/g, "\\'") %>', '<%= activePrice %>', '<%= product.imgUrl %>', '<%= product.category %>')" class="flex-1 bg-black text-white py-3.5 rounded-xl font-bold uppercase text-xs tracking-wider flex items-center justify-center gap-2 cursor-pointer shadow-md">
        <i class="fa-solid fa-cart-plus"></i> Add to Cart
    </button>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { height: 4px; width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
</style>

<script>
    const imgs = <%- JSON.stringify(imgs) %>;
    let activeIdx = 0;

    function switchImage(url, idx) {
        activeIdx = idx;
        document.getElementById('mainDisplayImg').src = url;
        const curr = document.getElementById('currIdx');
        if(curr) curr.innerText = idx + 1;

        document.querySelectorAll('.thumb-box').forEach(b => {
            b.classList.remove('border-black', 'ring-4', 'ring-gray-100', 'shadow-md', 'scale-95');
            b.classList.add('border-gray-200');
        });
        const target = document.querySelector(`.thumb-box[data-index="${idx}"]`);
        if(target) {
            target.classList.remove('border-gray-200');
            target.classList.add('border-black', 'ring-4', 'ring-gray-100', 'shadow-md', 'scale-95');
            target.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }
    }

    // Swipe Gesture Support
    const wrapper = document.getElementById('mainWrapper');
    let sX = 0, eX = 0, isDrag = false;
    wrapper.addEventListener('touchstart', e => sX = e.touches[0].clientX, {passive: true});
    wrapper.addEventListener('touchend', e => { eX = e.changedTouches[0].clientX; handleSwipe(); }, {passive: true});
    wrapper.addEventListener('mousedown', e => { sX = e.clientX; isDrag = true; });
    wrapper.addEventListener('mouseup', e => { if(!isDrag)return; eX = e.clientX; isDrag = false; handleSwipe(); });

    function handleSwipe() {
        const diff = sX - eX;
        if(Math.abs(diff) > 50) {
            if(diff > 0 && activeIdx < imgs.length - 1) switchImage(imgs[++activeIdx], activeIdx);
            else if(diff < 0 && activeIdx > 0) switchImage(imgs[--activeIdx], activeIdx);
        }
    }

    // Combined Cart & Buy Handler
    function handleCart(action, id, title, regularPrice, img, category) {
        const sizes = <%- product.sizes?.length ? JSON.stringify(product.sizes) : '[]' %>;
        if(action === 'buy') {
            localStorage.setItem('checkoutItem', JSON.stringify({ id, title, regularPrice: parseFloat(regularPrice) || 0, img, category, sizes, selectedSize: '', quantity: 1 }));
            localStorage.setItem('isDirectCheckout', 'true');
            return location.href = '/checkout';
        }

        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        const item = cart.find(i => i.id === id);
        if(item) {
            item.quantity += 1;
            Swal.fire({ title: 'Already in Cart!', text: "Quantity increased.", icon: 'info', confirmButtonColor: '#000' });
        } else {
            cart.push({ id, title, regularPrice: parseFloat(regularPrice) || 0, img, category, sizes, selectedSize: '', quantity: 1 });
            Swal.fire({ title: 'Success!', text: "Product added to cart.", icon: 'success', confirmButtonColor: '#000' });
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        window.dispatchEvent(new CustomEvent('cartUpdated'));
    }
</script>

<%- include('partials/footer') %>